# Targets chezmoi should delete, not just stop managing.
#
# Dropping a file from the source tree only makes chezmoi forget it — the copy
# already applied to a machine stays on disk. For a Neovim plugin spec that is
# not "unmanaged", it is "still loaded by lazy.nvim", so the old colorscheme
# would keep installing itself alongside token forever.
#
# Paths are target paths relative to $HOME, same as .chezmoiignore.

# Replaced by token (dot_config/nvim/lua/plugins/token.lua). The palettes for
# kanagawa are still in terminal-tools and still reachable via `theme pick`;
# this only removes the editor half.
.config/nvim/lua/plugins/kanagawa-paper.lua

# Kanagawa Paper took the editor back from token (1dddc55); the token spec was
# the half of that migration it left behind, still loading at startup unused.
.config/nvim/lua/plugins/token.lua

# jev-router was retired; pi sessions use the default model directly. Remove
# both the live extension and any disabled copy left from earlier.
.pi/agent/extensions/jev-router.ts
.pi/agent/extensions-disabled/jev-router.ts

# no-sleep was retired; the AGENTS.md waiting rule stays as guidance and the
# agent decides how to wait.
.pi/agent/extensions/no-sleep.ts

# silk-deps-seed (Linux) kept a silk-remix worktree installed; worktree-sweep now
# refreshes the main checkout instead (aglowinthefield/worktree-sweep).
.local/bin/silk-deps-seed
.config/systemd/user/silk-deps-seed.service
.config/systemd/user/silk-deps-seed.timer
