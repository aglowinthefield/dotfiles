{{- if eq .chezmoi.os "windows" -}}
# =============================================================================
# psmux config (Windows)
# =============================================================================
# Most settings are handled by psmux-sensible and psmux-pain-control plugins.
# Only declare plugins and settings that psmux can parse here.
# Avoid hyphenated option names — psmux converts them to $env: vars which
# PowerShell can't handle (e.g. $env:allow-rename is invalid).

unbind C-b
set -g prefix C-a
bind C-a send-prefix

# New panes/windows inherit the current pane's working directory
bind '"' split-window -v -c '#{pane_current_path}'
bind '%' split-window -h -c '#{pane_current_path}'

# List of plugins
set -g @plugin 'psmux-plugins/ppm'
set -g @plugin 'psmux-plugins/psmux-sensible'
run-shell 'C:\Users\clearing\.tmux\plugins\psmux-sensible\psmux-sensible.ps1'
set -g @plugin 'psmux-plugins/psmux-pain-control'
run-shell 'C:\Users\clearing\.tmux\plugins\psmux-pain-control\psmux-pain-control.ps1'
set -g @kanagawa-variant 'dragon'

run '~/.tmux/plugins/ppm/ppm.ps1'

# ── Plugins (managed by tmuxpanel) ──────────────────────
set -g @plugin 'psmux-plugins/psmux-resurrect'
run-shell 'C:\Users\clearing\.tmux\plugins/psmux-resurrect/psmux-resurrect.tmux'
set -g @plugin 'psmux-plugins/psmux-continuum'
run-shell 'C:\Users\clearing\.tmux\plugins/psmux-continuum/psmux-continuum.tmux'
set -g @plugin 'psmux-plugins/psmux-theme-gruvbox'
run-shell 'C:\Users\clearing\.tmux\plugins/psmux-theme-gruvbox/psmux-theme-gruvbox.tmux'
# ── End plugins ──────────────────────────────────────

{{- else -}}
# =============================================================================
# tmux config (macOS / Linux)
# =============================================================================

# --- Terminal / true color ---------------------------------------------------
# `sync` matters for nested TUIs (herdr): without it tmux drops the
# atomic-frame brackets and partial frames get painted. terminal-features
# supersedes the older terminal-overrides spelling.
set -g default-terminal "tmux-256color"
set -as terminal-features ",xterm-256color:RGB:sync"
set -as terminal-features ",alacritty:RGB:sync"

# --- Prefix ------------------------------------------------------------------
unbind C-b
set-option -g prefix C-a
bind-key C-a send-prefix

# --- Splits (open in current path) -------------------------------------------
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"

# --- Vim-style pane movement / resize ----------------------------------------
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

bind H resize-pane -L 5
bind J resize-pane -D 5
bind K resize-pane -U 5
bind L resize-pane -R 5

# --- Behaviour ---------------------------------------------------------------
set -g mouse on
set-option -g allow-rename off       # apps can't rename via escape seq
# Claude Code's process is named after its version (e.g. 2.1.218); show
# "claude" for any semver-like command name, otherwise use the command.
set -g automatic-rename-format '#{?#{m/r:^[0-9]+\.[0-9]+(\.[0-9]+)?$,#{pane_current_command}},claude,#{pane_current_command}}'
set-option -g renumber-windows on    # keep window numbers gapless
set -g base-index 1                  # windows start at 1
setw -g pane-base-index 1            # panes start at 1

setw -g xterm-keys on
set -sg repeat-time 600              # longer repeat window for resize
set -s focus-events on
set -s escape-time 50                # snappier ESC

# --- Plugins -----------------------------------------------------------------
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'vaaleyard/tmux-dotbar'

# tmux-dotbar theme. The palette lives in ~/.tmux/dotbar-{dark,light}.conf and
# is picked by `alacritty-theme`, which regenerates theme.conf alongside
# Alacritty's own and re-sources it into every running server — the status bar
# is meant to share the terminal's background, so the two switch together.
#
# Two sources, both -q on purpose: dark first as the fallback, so a machine that
# has never run alacritty-theme still gets the intended colours rather than
# tmux-dotbar's own defaults; then the generated file, which wins.
source-file -q ~/.tmux/dotbar-dark.conf
source-file -q ~/.tmux/theme.conf

set -g @tmux-dotbar-status-right-text " %H:%M "

# --- Init (keep last) --------------------------------------------------------
run '~/.tmux/plugins/tpm/tpm'
{{- end }}
