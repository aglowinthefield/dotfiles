{{- /* chezmoi:modify-template */ -}}
{{- /*
  Merge, don't overwrite: pi writes machine-local state into this file
  (deviceId, lastChangelogVersion), so only the keys below are enforced.
  A missing file gets the full seed.
*/ -}}
{{- $s := dict
      "packages" (list "npm:@gotgenes/pi-anthropic-auth" "npm:pi-multi-pass" "npm:billion-context" "npm:@mem0/pi-agent-plugin")
      "defaultTools" (list "+codemode") -}}
{{- if .chezmoi.stdin | trim }}{{ $s = fromJson .chezmoi.stdin }}{{ end -}}
{{- /* Enforced on existing machines too: mem0 memory must load on every host
       (pi installs a listed-but-missing package on next start). Appended, so
       packages added locally are kept. */ -}}
{{- $pkgs := get $s "packages" | default list -}}
{{- if not (has "npm:@mem0/pi-agent-plugin" $pkgs) }}{{ $s = setValueAtPath "packages" (append $pkgs "npm:@mem0/pi-agent-plugin") $s }}{{ end -}}
{{- /* jev/auto is the virtual model from extensions/jev-router.ts: it plans on
       Opus or Sonnet by Jev's read of the first prompt, then implements on Sonnet. */ -}}
{{- $s = setValueAtPath "defaultProvider" "jev" $s -}}
{{- $s = setValueAtPath "defaultModel" "auto" $s -}}
{{- /* No install ping to pi.dev. */ -}}
{{- $s = setValueAtPath "enableInstallTelemetry" false $s -}}
{{- /* Seeded, not enforced: hide the startup splash and the per-session
       Anthropic extra-usage warning, but leave values picked later in
       /settings alone. */ -}}
{{- if not (hasKey $s "quietStartup") }}{{ $s = setValueAtPath "quietStartup" true $s }}{{ end -}}
{{- if not (hasKey (get $s "warnings" | default dict) "anthropicExtraUsage") }}{{ $s = setValueAtPath "warnings.anthropicExtraUsage" false $s }}{{ end -}}
{{ toPrettyJson $s }}
