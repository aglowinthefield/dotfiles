{{- if ne .chezmoi.os "windows" }}
Documents/PowerShell
AppData
# psmux plugins are Windows-only
.tmux/plugins/ppm
.tmux/plugins/psmux-*
# komorebi + whkd are Windows-only. The bare `komorebi.json` only ever
# matched ~/komorebi.json, so the real one kept applying to macOS/Linux.
.config/whkd
.config/komorebi/komorebi.json
komorebi.json
# yasb is a Windows status bar and sysupdate.ps1 is a PowerShell script;
# neither does anything here. Note the path must be the full target path
# relative to $HOME — a bare `sysupdate.ps1` would only match ~/sysupdate.ps1.
.config/yasb
.local/bin/sysupdate.ps1
# The Alacritty palettes are Windows' substitute for the generated theme.toml.
# Everywhere else terminal-tools' install.sh fills this directory with
# symlinks into its own share/colors, and a chezmoi-managed regular file would
# fight those symlinks on every apply. Full target path — a bare `colors` would
# only match ~/colors.
.config/alacritty/colors
{{- end }}
{{- if ne .chezmoi.os "darwin" }}
# Homebrew only exists on the laptops; the aliases in here would be dead
# commands on mochi/tomauty/Windows.
.config/fish/conf.d/40_darwin_alias.fish
{{- end }}
{{- if eq .chezmoi.os "windows" }}
# secrets.env is loaded by config.fish, which is fish-only.
# Ignoring it here also means Windows needs no 1Password CLI session.
.config/secrets.env
# Hermes Agent does not run on the Windows box; its .env would only pull a
# Discord token nothing reads. Full target path, per the note above.
.hermes/.env
# herdr ssh-status daemon talks to a unix socket
bin/herdr-ssh-status.py
# Windows imports its theme directly and keeps its font inline rather than
# going through the generated theme.toml / font.toml, so it needs neither the
# per-host font default nor the terminal-tools checkout that reads it.
.config/alacritty/font-default.toml
# bat is not in the scoop/winget lists, so the config and its two token themes
# would sit unread — and `bat cache --build` is not there to compile them.
.config/bat
{{- end }}
# kitty-palettes generates ~/.config/kitty/themes from terminal-tools'
# share/colors on every apply, and `kitten themes` writes downloaded themes into
# the same directory. Managing either set here would fight both writers. Full
# target path — a bare `themes` would only match ~/themes.
.config/kitty/themes
# `kitten themes` writes current-theme.conf whenever a theme is picked without
# --config-file-name. Nothing seeds it, so it is ignored rather than managed.
.config/kitty/current-theme.conf

# ghostty-palettes generates ~/.config/ghostty/themes from terminal-tools'
# share/colors, the same bargain as .config/kitty/themes above: Ghostty resolves
# `theme = Token Dark` by file name out of this directory, and the converter
# rewrites every file in it. Full target path — a bare `themes` would only match
# ~/themes.
.config/ghostty/themes

# ── Deliberately unmanaged: this repo is public ──────────────────────────────
# 1Password's agent.toml has to name SSH items literally, which would publish
# work identities. Keep it local; if a new machine needs the same key order,
# copy ~/.config/1Password/ssh/agent.toml across by hand.
.config/1Password
# Host-specific ssh blocks — internal hostnames, login users, per-host keys.
# Included from the managed ~/.ssh/config.
.ssh/config.local
.ssh/config.backup-*
{{- if ne .chezmoi.hostname "mochi" }}
# The portfolio feed only runs on mochi, via systemd EnvironmentFile.
# Nowhere else needs the credentials, so nowhere else provisions them.
.config/portfolio/env
# darkman is mochi's light/dark oracle: it has the i3 session worth theming,
# the laptops already have dark-notify, and tomauty has no desktop at all.
# Full target paths — a bare `darkman` would only match ~/darkman.
.config/darkman
.local/share/darkman
{{- end }}
.config/nvim/lazy-lock.json
# herdr writes these itself and stamps each with a HERDR_INTEGRATION_VERSION it
# bumps on update — they were already 9 (claude) and 8 (codex) at the time of
# writing, drifting apart per agent. Managed as regular files, every
# `chezmoi apply` would revert whatever herdr last installed. Same bargain as
# .claude/settings.json, which is create_private_settings.json for this exact
# reason; these are ignored outright because nothing here needs to seed them.
.claude/hooks/herdr-agent-state.sh
.codex/herdr-agent-state.sh
# Guidance for agents working on this source repo, not a dotfile. Without this
# chezmoi would render it to ~/AGENTS.md, where it describes the wrong tree.
AGENTS.md
