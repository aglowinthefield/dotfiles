{{- if ne .chezmoi.os "windows" }}
Documents/PowerShell
# psmux plugins are Windows-only
.tmux/plugins/ppm
.tmux/plugins/psmux-*
# komorebi + whkd are Windows-only. The bare `komorebi.json` only ever
# matched ~/komorebi.json, so the real one kept applying to macOS/Linux.
.config/whkd
.config/komorebi/komorebi.json
komorebi.json
# yasb is a Windows status bar and sysupdate.ps1 is a PowerShell script;
# neither does anything here. Note the path must be the full target path
# relative to $HOME — a bare `sysupdate.ps1` would only match ~/sysupdate.ps1.
.config/yasb
.local/bin/sysupdate.ps1
{{- end }}
{{- if eq .chezmoi.os "windows" }}
# secrets.env is loaded by config.fish, which is fish-only.
# Ignoring it here also means Windows needs no 1Password CLI session.
.config/secrets.env
# herdr ssh-status daemon talks to a unix socket
bin/herdr-ssh-status.py
{{- end }}
{{- if eq .chezmoi.os "linux" }}
# 1Password's desktop SSH agent is macOS/Windows only. Linux signs with
# ~/.ssh/op_signing_key through the system ssh-agent, so agent.toml is inert.
.config/1Password
{{- end }}
{{- if ne .chezmoi.hostname "mochi" }}
# The portfolio feed only runs on mochi, via systemd EnvironmentFile.
# Nowhere else needs the credentials, so nowhere else provisions them.
.config/portfolio/env
{{- end }}
.config/nvim/lazy-lock.json
