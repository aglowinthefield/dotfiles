# darkman — the light/dark oracle for this machine.
#
# mochi is meant to look like the time of day *where it is*, not like whatever
# laptop I happen to be SSH'd in from. So the mode comes from this box's own
# sunrise/sunset, and tmux's mode-2031 client theme is deliberately left
# unwired: it tracks the far-end terminal and would fight this over theme.conf.
#
# Transitions run every executable in ~/.local/share/darkman/ with `dark` or
# `light` as $1 — the same calling convention dark-notify uses on macOS, which
# is why alacritty-theme is a hook here with no wrapper.

# Fixed coordinates, not geoclue. These came *from* a geoclue GeoIP lookup
# (~25km, far finer than a sunrise time needs), but mochi does not move, so
# resolving them again on every boot buys nothing and costs three things: a
# network round-trip to beacondb, a wrong answer the day this box egresses
# through a VPN, and a [darkman] allowed=true block in /etc/geoclue/geoclue.conf
# — without which every lookup hangs waiting for an authorisation agent that a
# bare i3 session never starts.
#
# usegeoclue already defaults to false, but say it out loud: whoever reads this
# next should not have to know the default to be sure geoclue is not in play.
usegeoclue: false
lat: 41.8268
lng: -74.1263

# Publish on org.freedesktop.appearance/color-scheme as well. Nothing reads it
# yet — xdg-desktop-portal needs org.freedesktop.impl.portal.Settings=darkman in
# /etc/xdg-desktop-portal before its frontend routes to the darkman.portal the
# package ships — but it costs nothing and is ready if something wants it.
portal: true
