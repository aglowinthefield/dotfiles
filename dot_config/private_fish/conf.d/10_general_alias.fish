# General aliases that are used regardless of platform
alias x exit
alias c clear
alias vim nvim
alias cc "claude --dangerously-skip-permissions"

# Theme. `theme` alone reports what is on; `theme pick` browses every installed
# palette with the terminal repainting live as you move.
alias theme alacritty-theme

# Fish
alias sf "source ~/.config/fish/config.fish"
alias conf "vim ~/.config"

# Git
alias gs "git status"
alias gd "git diff"
alias gdc "git diff --cached"
alias gco "git checkout"
