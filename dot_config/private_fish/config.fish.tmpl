source ~/.config/fish/functions.fish

if status is-interactive
    set -g fish_greeting
    fish_vi_key_bindings
    # Clear mouse reporting left behind by a terminal app or disconnected SSH.
    function clear_mouse_reporting --on-event fish_prompt
        printf '\e[?1000l\e[?1002l\e[?1003l'
    end
    if command -q starship
        starship init fish | source
    end
    if command -q fnm
        fnm env --use-on-cd --shell fish | source
    end
end

# Node shims pick the Node pinned by the nearest .nvmrc each time node runs, so
# agents started from this shell follow a repo's pin after they change directory.
# After fnm env, which prepends its own directory.
fish_add_path --global --move --path ~/.local/share/node-shims

set -x XDG_CONFIG_HOME $HOME/.config
# czkawka_gui requires $XDG_DATA_DIRS to contain "/usr/local/share".
if not set -q XDG_DATA_DIRS[1]; or test -z "$XDG_DATA_DIRS"
    set -gx XDG_DATA_DIRS /usr/local/share:/usr/share
else if not contains -- /usr/local/share (string split : -- $XDG_DATA_DIRS)
    set -gx XDG_DATA_DIRS /usr/local/share:$XDG_DATA_DIRS
end

set -gx CLEARSTACK_RECORD off

set -gx EDITOR nvim
set -gx ENABLE_LSP_TOOL 1
set -gx MEM0_CODE_USER_ID clearing
if test -r ~/.codex/plugins/data/mem0-mem0-plugins/api-key
    set -gx MEM0_API_KEY (string collect < ~/.codex/plugins/data/mem0-mem0-plugins/api-key)
end
{{ if eq .chezmoi.os "darwin" }}
fish_add_path /opt/homebrew/opt/ruby/bin
fish_add_path /opt/homebrew/lib/ruby/gems/4.0.0/bin
# Kitty bundles completions for kitten that fish does not ship.
if test -d /Applications/kitty.app/Contents/Resources/kitty/shell-integration/fish/vendor_completions.d
    set --prepend fish_complete_path /Applications/kitty.app/Contents/Resources/kitty/shell-integration/fish/vendor_completions.d
end
{{ end }}

fish_add_path ~/.local/bin
fish_add_path ~/.cargo/bin
fish_add_path ~/.opencode/bin

# Load secrets from central store (~/.config/secrets.env), skipping comments/blanks.
# Every OS with fish: the file is provisioned from 1Password on macOS and Linux,
# and the guard keeps this a no-op wherever it is absent.
if test -r ~/.config/secrets.env
    for line in (grep -vE '^\s*#|^\s*$' ~/.config/secrets.env)
        set -gx (string split -m1 '=' -- $line)
    end
end

# Claude Code uses its saved login instead of a token inherited from a parent.
set -e CLAUDE_CODE_OAUTH_TOKEN

{{ if eq .chezmoi.os "linux" }}

if status is-interactive
    and not set -q TMUX
    and test "$DISPLAY" = ":0"
    # Automatically use tmux for VNC / local desktop sessions only.
    # SSH sessions should open a regular interactive shell.
    set SESSION_NAME vnc

    if tmux has-session -t $SESSION_NAME
        exec tmux attach-session -t $SESSION_NAME
    else
        tmux new-session -s $SESSION_NAME
    end
end

set -g -x SYSTEMD_EDITOR vim
# Only wire up the ssh-agent socket if it actually exists on this machine.
# Headless servers have no ssh-agent.socket, so skip it to avoid
# "Error connecting to agent: No such file or directory" on login.
if test -S $XDG_RUNTIME_DIR/ssh-agent.socket
    set -g -x SSH_AUTH_SOCK $XDG_RUNTIME_DIR/ssh-agent.socket
    ssh-add -l | grep -q op_signing_key; or ssh-add ~/.ssh/op_signing_key 2>/dev/null
end
{{- end }}
{{- if eq .chezmoi.hostname "mochi" }}

