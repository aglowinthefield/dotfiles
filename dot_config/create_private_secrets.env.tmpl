# ~/.config/secrets.env  —  central plaintext secret store (chmod 600, redbean only)
# Format: KEY=VALUE, one per line. No quotes, no spaces around '='.
# Loaded into the shell environment by ~/.config/fish/config.fish.
#
# NOTE: tools that read their own YAML config (beets, caesura) do NOT read
# env vars. Their keys are duplicated here only as a central inventory — the
# real value each of those tools uses still lives in its own config file.
#
# Values come from the 1Password item "dotfiles-secrets". The create_ prefix
# means chezmoi writes this file only when it is absent, so local edits are
# never clobbered; to pull a rotated key, delete the file and apply again.
{{- $f := onepasswordDetailsFields "dotfiles-secrets" "Private" }}

# --- Live via env (LLM CLIs, anything that reads these env vars) ---
OPENAI_API_KEY={{ (index $f "OPENAI_API_KEY").value }}
ANTHROPIC_API_KEY={{ (index $f "ANTHROPIC_API_KEY").value }}
GOOGLE_API_KEY={{ (index $f "GOOGLE_API_KEY").value }}
OPENROUTER_API_KEY={{ (index $f "OPENROUTER_API_KEY").value }}

# --- Inventory only (each tool reads these from its own YAML, not env) ---
# RED / redacted.sh  — single key used by beets, caesura, smoked-salmon, mochis/betanin
RED_API_KEY={{ (index $f "RED_API_KEY").value }}
# Last.fm (beets fetchart lastfm_key)
LASTFM_KEY={{ (index $f "LASTFM_KEY").value }}
# Subsonic (beets subsonic pass)
SUBSONIC_PASS={{ (index $f "SUBSONIC_PASS").value }}

# --- Placeholder: fill in when you get one ---
# DISCOGS_TOKEN=
