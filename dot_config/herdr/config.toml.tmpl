onboarding = false

[ui]
agent_panel_sort = "spaces"
show_agent_labels_on_pane_borders = false
status_indicators = "symbols"

# Toasts go to the terminal rather than the macOS notification centre, so they
# stay with the session that raised them instead of needing Do Not Disturb
# managed separately.
[ui.toast]
delivery = "terminal"

[ui.sidebar.spaces]
# `$ssh` is a custom metadata token showing the remote host while a session
# is up. Two things can feed it, and only one runs per OS:
#   macOS — ~/bin/herdr-ssh-status.py (launchd: com.tauty.herdr-ssh-status),
#           which polls pane foreground processes, so it also catches
#           `ssh host cmd`, mosh and autossh, and expires via TTL.
#   Linux — the `ssh` wrapper in functions.fish.tmpl.
# Never both at once: they report the same token from different sources and
# would overwrite each other.
rows = [
  # #7E9CD8 is kanagawa's crystalBlue, to match the theme set below.
  ["state_icon", "workspace", { token = "$ssh", fg = "#7E9CD8" }],
  ["branch", "git_status"],
]

# Agents list (bottom left): show the Claude session summary, which Claude
# Code publishes as the terminal title, then the agent name on its own row.
[ui.sidebar.agents.rows_by_agent]
claude = [
  ["state_icon", "workspace", "tab"],
  ["terminal_title_stripped"],
  ["agent"],
]

# reviewr (persiyanov/herdr-reviewr): a code-review pane for the agent's diff.
# The qualified action id is required — `toggle` alone is not unique across
# plugins. prefix+d rather than a bare ctrl+alt chord, which Alacritty on macOS
# swallows unless Option is mapped to Alt. reviewr's own settings live in
# plugins/config/persiyanov.reviewr/config.toml.
[[keys.command]]
key = "prefix+d"
type = "plugin_action"
command = "persiyanov.reviewr.toggle"
description = "toggle reviewr"

[theme]
name = "terminal"
# Follow the terminal palette directly.
auto_switch = false
dark_name = "kanagawa"
light_name = "kanagawa-lotus"
{{- if eq .chezmoi.os "windows" }}

# Windows has no usable $SHELL for herdr to inherit, so point it at pwsh.
# Linux/macOS herdr follows $SHELL, so default_shell stays unset there.
[terminal]
default_shell = "C:\\Program Files\\PowerShell\\7\\pwsh.exe"
{{- end }}
