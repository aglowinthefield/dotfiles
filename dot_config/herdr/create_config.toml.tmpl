# `create_` on purpose: chezmoi writes this file only when it is absent, so it
# seeds a new machine and then never touches it again. herdr's TUI writes the
# file back whenever the theme is changed from inside it, and a plain managed
# file would have chezmoi apply revert that pick on the next run. Same bargain
# as ~/.claude/settings.json and secrets.env. Edit here to move the baseline a
# fresh machine starts from; delete the live file and re-apply to take it.

onboarding = false

[ui]
agent_panel_sort = "spaces"
show_agent_labels_on_pane_borders = false
status_indicators = "symbols"

# Toasts go to the terminal rather than the macOS notification centre, so they
# stay with the session that raised them instead of needing Do Not Disturb
# managed separately.
[ui.toast]
delivery = "terminal"

[ui.sidebar.spaces]
# `$ssh` is a custom metadata token showing the remote host while a session
# is up. Two things can feed it, and only one runs per OS:
#   macOS — ~/bin/herdr-ssh-status.py (launchd: com.tauty.herdr-ssh-status),
#           which polls pane foreground processes, so it also catches
#           `ssh host cmd`, mosh and autossh, and expires via TTL.
#   Linux — the `ssh` wrapper in functions.fish.tmpl.
# Never both at once: they report the same token from different sources and
# would overwrite each other.
rows = [
  # This fg has to be a literal hex — herdr's sidebar rows reject ANSI colour
  # names ("data did not match any variant of RawSidebarToken"), so unlike the
  # starship prompt it cannot follow the terminal's light/dark switch. #587989
  # is Kanagawa Paper's dragonBlue2 (#859fac) walked 97% toward canvasBlue3
  # (#577888): the point that maximises the *worse* of the two contrasts,
  # 3.51:1 on ink's #1f1f28 and 3.55:1 on canvas's #e1e1de.
  ["state_icon", "workspace", { token = "$ssh", fg = "#587989" }],
  ["branch", "git_status"],
]

# Agents list (bottom left): show the Claude session summary, which Claude
# Code publishes as the terminal title, then the agent name on its own row.
[ui.sidebar.agents.rows_by_agent]
claude = [
  ["state_icon", "workspace", "tab"],
  ["terminal_title_stripped"],
  ["agent"],
]

# reviewr (persiyanov/herdr-reviewr): a code-review pane for the agent's diff.
# The qualified action id is required — `toggle` alone is not unique across
# plugins. prefix+d rather than a bare ctrl+alt chord, which Alacritty on macOS
# swallows unless Option is mapped to Alt. reviewr's own settings live in
# plugins/config/persiyanov.reviewr/config.toml.
[[keys.command]]
key = "prefix+d"
type = "plugin_action"
command = "persiyanov.reviewr.toggle"
description = "toggle reviewr"

# Kanagawa Paper — chrome colours derived from the colorscheme's own palette so
# the sidebar matches the editor and the terminal exactly:
#   thesimonho/kanagawa-paper.nvim  lua/kanagawa-paper/colors.lua
# The values below are the ink theme (bg sumiInk3 #1f1f28); the canvas theme
# (bg canvasWhite4 #e1e1de) is kept commented out at the end of the file.
# Every value below is a literal palette entry, not a hand-mixed tint. Re-derive
# from the plugin after updating it, alongside the Alacritty palettes in
# ~/.config/alacritty/colors/kanagawa-paper-{ink,canvas}.toml. `name`/
# `auto_switch` above them are fair game — that is what the TUI writes, and why
# this file is `create_`.
#
# Herdr's built-in `kanagawa` palette keeps the tab chrome contrast-safe.
[theme]
name = "kanagawa"
auto_switch = false
dark_name = "kanagawa"
light_name = "kanagawa-lotus"

# The built-in palette is selectable from Herdr's theme picker and does not
# override other built-in themes.

# Kanagawa Paper Canvas — unused while auto_switch is off. See the note above
# [theme.custom].
#
# [theme.custom.light]
# accent = "#7e8faf"        # canvasTeal1, the canvas theme's primary accent
# panel_bg = "#e1e1de"      # canvasWhite4
# sidebar_bg = "#e1e1de"
# active_row_bg = "#d8d8d2" # canvasWhite3
# selection_bg = "#d4cdd4"  # canvasPink3, the editor's visual selection
# surface0 = "#d8d8d2"
# surface1 = "#d1cfc5"      # canvasWhite2
# surface_dim = "#cbc8bc"   # canvasWhite1
# overlay0 = "#aeaea6"      # canvasGray1
# overlay1 = "#99958a"
# text = "#73787d"          # canvasGray3
# subtext0 = "#8e8a80"      # canvasGray2
# mauve = "#9e7e98"
# green = "#7e9579"
# yellow = "#a7956a"
# red = "#c27672"
# blue = "#6b8998"          # canvasBlue2, darker than ANSI blue for contrast
# teal = "#7b958e"
# peach = "#a8826a"         # canvasOrange2, darker than ANSI's #b28d77
{{- if eq .chezmoi.os "windows" }}

# Windows has no usable $SHELL for herdr to inherit, so point it at pwsh.
# Linux/macOS herdr follows $SHELL, so default_shell stays unset there.
[terminal]
default_shell = "C:\\Program Files\\PowerShell\\7\\pwsh.exe"
{{- end }}
