# Per-host accent: each machine gets a distinct color so hosts are
# instantly distinguishable at a glance. Add a host to the map below;
# anything not listed falls back to "default".
#
# ANSI palette *names*, not hex. The terminal redefines these per theme, so the
# prompt follows alacritty-theme into light mode instead of staying at the
# dark-mode pastels it used to hardcode (#BFA8BF was 1.7:1 on a light bg —
# no single fixed hex can clear 4.5:1 against both a near-white and a
# near-black background, so hosts are told apart by hue slot, not by tint).
{{ $accent := dict
  "tomauty"      "yellow"
  "mochi"        "red"
  "visitingstar" "cyan"
  "default"      "purple" -}}
{{ $c := get $accent .chezmoi.hostname | default (get $accent "default") }}
# Starship prompt — ported from OMP uew theme
# Line 1: ~ username  branch  shell
# Line 2: ~ path ~

format = """
[~](fg:{{ $c }}) $username$hostname$git_branch$shell
[~](fg:{{ $c }}) $directory$character"""

# No right prompt — we dropped that for speed
right_format = ""

[username]
style_user = "fg:green"
style_root = "fg:green"
format = "[$user ]($style)"
show_always = true

[hostname]
# Show the host name only over SSH, so the local machine stays clean.
ssh_only = true
format = "[$hostname ](fg:{{ $c }})"

[git_branch]
symbol = "\ue725 "
style = "fg:{{ $c }}"
format = "[$symbol$branch]($style) "

[shell]
disabled = false
format = "[\uf120](fg:{{ $c }}) [$indicator]($style) "
style = "fg:{{ $c }}"
pwsh_indicator = "pwsh"
bash_indicator = "bash"
fish_indicator = "fish"

[directory]
style = "fg:blue"
format = "[\ue5ff $path]($style) "
truncation_length = 0
home_symbol = "home"
fish_style_pwd_dir_length = 0

[character]
success_symbol = "[~](fg:{{ $c }})"
error_symbol = "[~](fg:red)"
vimcmd_symbol = "[~](fg:{{ $c }})"
