# ~/.gitconfig (managed by chezmoi)

[user]
    # Personal identity (default)
    name = aglowinthefield
    email = 146008217+aglowinthefield@users.noreply.github.com
    signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEu7PGIiUMTrrk1KhsAUZPgRNPCfLg5sSsYlNwSo4sho

[commit]
    # Sign commits where a signer is available (1Password on macOS/Windows).
    # Disabled only on the 'tomauty' server, which has no signing agent and
    # would otherwise fail commits with "Error connecting to agent".
    {{- if eq .chezmoi.hostname "tomauty" }}
    gpgsign = false
    {{- else }}
    gpgsign = true
    {{- end }}

[gpg]
    # Use SSH signing (1Password)
    format = ssh

[gpg "ssh"]
  # Verify signatures locally; without this every `%G?` / --show-signature errors out
  allowedSignersFile = ~/.ssh/allowed_signers
  {{- if eq .chezmoi.os "windows" }}
  program = "~/AppData/Local/Microsoft/WindowsApps/op-ssh-sign.exe"
  {{- else if eq .chezmoi.os "darwin" }}
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
  {{- else }}
  program = ssh-keygen
  {{- end }}

# ---- Never use HTTPS for GitHub ----
# Rewrites any https://github.com/... URL to SSH, including remotes created by
# `git clone`, submodules, and tooling that hardcodes HTTPS. GitHub refuses
# password auth, so an HTTPS remote can fetch but never push — this makes that
# failure impossible to walk into. Requires an SSH key for github.com on the
# machine; drop this block if one is ever without.
[url "git@github.com:"]
    insteadOf = https://github.com/
    insteadOf = git://github.com/

# ---- Work identity overrides below ----
# Any repo under ~/dev/ will use ~/.gitconfig_work
[includeIf "gitdir:~/dev/"]
    path = ~/.gitconfig_work

# ---- Personal identity restore for aglowinthefield repos ----
# Any repo whose remote points at github.com/aglowinthefield/* uses ~/.gitconfig_personal,
# overriding the ~/dev/ work override above. Matches both SSH and HTTPS remote URLs.
[includeIf "hasconfig:remote.*.url:git@github.com:aglowinthefield/**"]
    path = ~/.gitconfig_personal
[includeIf "hasconfig:remote.*.url:https://github.com/aglowinthefield/**"]
    path = ~/.gitconfig_personal

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    default = current
    autoSetupRemote = true

[color]
    ui = auto

[safe]
  directory = *

[core]
  {{- if eq .chezmoi.os "windows" }}
  autocrlf = true
  whitespace = cr-at-eol
  sshCommand = "C:/Windows/System32/OpenSSH/ssh.exe"
  {{- end }}
