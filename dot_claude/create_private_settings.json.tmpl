{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "cloudflare@cloudflare": true,
    "obsidian@obsidian-skills": true
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    }
  },
  "theme": "dark",
  "tui": "fullscreen",
  "verbose": false,
  "remoteControlAtStartup": false,
  "isolatePeerMachines": false,
  "agentPushNotifEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(ssh mochi:*) commands that sync/rotate credentials or modify systemd timers without confirmation"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": {{ if eq .chezmoi.os "windows" }}{{ printf "python \"%s/.agents/skills/clear-voice/scripts/pr-body-guard\"" .chezmoi.homeDir | toJson }}{{ else }}"python3 \"$HOME/.agents/skills/clear-voice/scripts/pr-body-guard\""{{ end }},
            "timeout": 10,
            "statusMessage": "PR body humanizer gate"
          }
        ]
      }
    ]
  }
}
