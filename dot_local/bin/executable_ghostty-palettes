#!/bin/sh
# Convert terminal-tools' vendored palettes into Ghostty theme files.
#
# Sibling of kitty-palettes, and there for the same reason: Ghostty ships 463
# themes of its own, but not `token` — that palette exists only as the neovim
# colorscheme's kitty extra, vendored in terminal-tools as TOML for alacritty.
# This writes each one into ~/.config/ghostty/themes, where Ghostty resolves
# `theme = Token Dark` by file name and `ghostty +list-themes` lists it as
# "(user)" alongside the built-ins.
#
# Ghostty theme files carry no extension and no metadata header: the file name
# is the theme name. That is why this writes "Token Dark" rather than
# "token-dark.conf" — a name that has to match what `ghostty-theme auto` is
# given, and what kitty-palettes produces, so all three terminals name the same
# palette the same way.
#
# Re-run after refreshing terminal-tools' share/colors. Output files are
# overwritten; nothing else in the themes directory is touched.
set -eu

SHARE="${ALACRITTY_TOOLS_SHARE:-$HOME/code/terminal-tools/share}"
SRC="$SHARE/colors"
DEST="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/themes"

[ -d "$SRC" ] || { echo "ghostty-palettes: no palettes at $SRC" >&2; exit 1; }
mkdir -p "$DEST"

# token-flint-dark -> "Token Flint Dark". Underscores and hyphens both split;
# the picker sorts on this, not on the file name.
pretty() {
	printf '%s\n' "$1" | tr '_-' '  ' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2)}1'
}

count=0
for f in "$SRC"/*.toml; do
	[ -e "$f" ] || continue
	base=${f##*/}; base=${base%.toml}
	name=$(pretty "$base")

	{
		printf '# %s\n' "$name"
		printf '# Generated by ghostty-palettes from %s — edits are overwritten.\n\n' "$f"

		# Alacritty groups colours in [colors.*] tables; Ghostty uses a flat key
		# space plus a repeatable `palette = N=#hex`. Track the current table and
		# map on (table, key), the same way kitty-palettes does.
		awk '
		/^\[/ { table = $0; sub(/^\[colors\./, "", table); sub(/\]$/, "", table); next }
		/^[a-z_]+[ \t]*=/ {
			key = $1
			val = $0; sub(/^[^=]*=[ \t]*/, "", val); gsub(/['"'"'"]/, "", val)
			m[table "." key] = val
		}
		END {
			split("black red green yellow blue magenta cyan white", names, " ")
			for (i = 1; i <= 8; i++) printf "palette = %d=%s\n", i - 1, m["normal." names[i]]
			for (i = 1; i <= 8; i++) printf "palette = %d=%s\n", i + 7, m["bright." names[i]]
			printf "\nbackground = %s\n", m["primary.background"]
			printf "foreground = %s\n", m["primary.foreground"]
			printf "cursor-color = %s\n", m["cursor.cursor"]
			printf "cursor-text = %s\n", m["cursor.text"]
			printf "selection-background = %s\n", m["selection.background"]
			printf "selection-foreground = %s\n", m["selection.foreground"]
		}' "$f"
	} > "$DEST/$name"

	count=$((count + 1))
done

printf 'ghostty-palettes: wrote %d themes to %s\n' "$count" "$DEST"
