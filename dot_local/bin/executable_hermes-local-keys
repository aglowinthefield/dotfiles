#!/usr/bin/env python3
"""Git filter that keeps per-host keys out of hermes-home's config.yaml files.

Each host picks its own pet, dashboard theme and fonts in the Hermes UI, which
writes them into the tracked config.yaml. Fonts are per host because each OS has
its own installed set: a Windows pick like Segoe UI falls back on macOS. Committed, one host's pick overwrites every
other host's on the next pull. Hermes has no per-host config layer (its managed
overlay beats the user's own choice), so this filter does the job in git:

  clean   strips the keys from what git stores and stashes this host's values
          in the clone's git dir, keyed by path
  smudge  puts the stashed values back into whatever git checks out

Registered for hermes-home by chezmoi's 58_hermes-home-pull script, which also
runs `clean` once before each pull: git skips the filter on a file whose stat
matches the index, and an unseeded smudge would drop the host's values.

Usage: hermes-local-keys clean|smudge <path>   (content on stdin, result on stdout)
"""
import json
import re
import subprocess
import sys
from pathlib import Path

# (top-level section, two-space child) pairs that belong to the host, not the repo.
LOCAL = {
    ("display", "pet"),
    ("dashboard", "theme"),
    ("terminal", "font_family"),
    ("desktop", "font_family"),
}

SECTION = re.compile(r"^([^\s#][^:]*):")
CHILD = re.compile(r"^  ([^\s#][^:]*):")


def strip(text):
    """Split text into (kept lines, {"section.key": block}). Line-based, so the
    rest of the file keeps its exact formatting and comments."""
    kept, blocks, section, owner = [], {}, None, None
    for line in text.splitlines(keepends=True):
        if owner and line.startswith("   "):
            blocks[owner] += line
            continue
        owner = None
        if m := SECTION.match(line):
            section = m[1]
        elif (m := CHILD.match(line)) and (section, m[1]) in LOCAL:
            owner = f"{section}.{m[1]}"
            blocks[owner] = line if line.endswith("\n") else line + "\n"
            continue
        kept.append(line)
    return kept, blocks


def store_path():
    git_dir = subprocess.run(["git", "rev-parse", "--git-dir"], capture_output=True, text=True, check=True).stdout.strip()
    return Path(git_dir) / "hermes-local-keys.json"


def load(store):
    try:
        return json.loads(store.read_text())
    except (OSError, ValueError):
        return {}


def main():
    mode, path = sys.argv[1], sys.argv[2]
    text = sys.stdin.read()
    store = store_path()
    stash = load(store)
    kept, blocks = strip(text)

    if mode == "clean":
        # Only content that still carries the keys says anything about this host.
        if blocks and stash.get(path) != blocks:
            stash[path] = blocks
            store.write_text(json.dumps(stash, indent=2) + "\n")
        sys.stdout.write("".join(kept))
        return

    # smudge: the host's own values win over anything an older commit still carries.
    blocks.update(stash.get(path, {}))
    for owner, block in blocks.items():
        section = owner.split(".", 1)[0]
        header = next((i for i, line in enumerate(kept) if SECTION.match(line) and SECTION.match(line)[1] == section), None)
        if header is None:
            if kept and not kept[-1].endswith("\n"):
                kept[-1] += "\n"
            kept += [f"{section}:\n", block]
        else:
            kept.insert(header + 1, block)
    sys.stdout.write("".join(kept))


if __name__ == "__main__":
    main()
