#!/usr/bin/env bash
# Keeps a locked worktree of silk-remix at origin/main with a finished npm install.
# silk-remix's scripts/worktree-deps.sh hardlinks a new worktree's node_modules
# from any checkout under .worktrees/ whose install matches the worktree's
# lockfile. Without a fresh source, every new worktree runs a full npm ci
# (26-86 s and 2.6 GB on mochi). A clone from the seed takes about 3 s.
#
# Runs hourly from silk-deps-seed.timer on Linux. Exits quietly where silk-remix
# is not cloned. npm ci replaces files instead of writing through them, so
# worktrees already cloned from the seed keep their own copies.
set -euo pipefail

repo="${SILK_REMIX:-$HOME/code/silk-remix}"
seed="$repo/.worktrees/_deps-seed"
[ -d "$repo/.git" ] || exit 0

git -C "$repo" fetch -q origin main
if [ ! -e "$seed/.git" ]; then
  git -C "$repo" worktree prune
  git -C "$repo" worktree add -q --detach "$seed" origin/main
  # worktree-sweep skips locked worktrees.
  git -C "$repo" worktree lock --reason "silk-deps-seed: source for worktree-deps.sh" "$seed"
fi

old="$(git -C "$seed" rev-parse HEAD:package-lock.json)"
git -C "$seed" checkout -q -f --detach origin/main
new="$(git -C "$seed" rev-parse HEAD:package-lock.json)"

if [ "$old" != "$new" ] || [ ! -f "$seed/node_modules/.package-lock.json" ]; then
  echo "silk-deps-seed: lockfile changed, reinstalling at $(git -C "$seed" rev-parse --short HEAD)"
  (cd "$seed" && npm ci --no-audit --no-fund)
else
  echo "silk-deps-seed: install is current at $(git -C "$seed" rev-parse --short HEAD)"
fi
