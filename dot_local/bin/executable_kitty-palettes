#!/bin/sh
# Convert terminal-tools' vendored palettes into kitty theme files.
#
# kitty's own theme repository (kovidgoyal/kitty-themes, ~410 themes, browsed
# with `kitten themes`) carries gruvbox, nord, kanagawa, flexoki and the rest,
# but not `token` — that palette exists only as the neovim colorscheme's kitty
# extra, vendored here as TOML for alacritty. This writes each one out as a
# kitty .conf in ~/.config/kitty/themes, where the themes kitten picks it up
# and lists it alongside the downloaded ones.
#
# Re-run after refreshing terminal-tools' share/colors. Output files are
# overwritten; nothing else in the themes directory is touched.
set -eu

SHARE="${ALACRITTY_TOOLS_SHARE:-$HOME/code/terminal-tools/share}"
SRC="$SHARE/colors"
DEST="${XDG_CONFIG_HOME:-$HOME/.config}/kitty/themes"

[ -d "$SRC" ] || { echo "kitty-palettes: no palettes at $SRC" >&2; exit 1; }
mkdir -p "$DEST"

# token-flint-dark -> "Token Flint Dark". Underscores and hyphens both split;
# the picker sorts on this, not on the file name.
pretty() {
	printf '%s\n' "$1" | tr '_-' '  ' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2)}1'
}

count=0
for f in "$SRC"/*.toml; do
	[ -e "$f" ] || continue
	base=${f##*/}; base=${base%.toml}
	name=$(pretty "$base")

	{
		printf '## name: %s\n' "$name"
		printf '## upstream: %s\n' "$f"
		printf '## blurb: Converted from the terminal-tools palette of the same name.\n'
		printf '\n# Generated by kitty-palettes — edits are overwritten.\n\n'

		# Alacritty groups colours in [colors.*] tables; kitty uses a flat
		# key space. Track the current table and map on (table, key).
		awk '
		/^\[/ { table = $0; sub(/^\[colors\./, "", table); sub(/\]$/, "", table); next }
		/^[a-z_]+[ \t]*=/ {
			key = $1
			val = $0; sub(/^[^=]*=[ \t]*/, "", val); gsub(/['"'"'"]/, "", val)
			m[table "." key] = val
		}
		END {
			printf "background            %s\n", m["primary.background"]
			printf "foreground            %s\n\n", m["primary.foreground"]
			printf "cursor                %s\n", m["cursor.cursor"]
			printf "cursor_text_color     %s\n\n", m["cursor.text"]
			printf "selection_background  %s\n", m["selection.background"]
			printf "selection_foreground  %s\n\n", m["selection.foreground"]
			split("black red green yellow blue magenta cyan white", names, " ")
			print "# normal"
			for (i = 1; i <= 8; i++) printf "color%-17d %s\n", i - 1, m["normal." names[i]]
			print ""
			print "# bright"
			for (i = 1; i <= 8; i++) printf "color%-17d %s\n", i + 7, m["bright." names[i]]
		}' "$f"
	} > "$DEST/$name.conf"

	count=$((count + 1))
done

printf 'kitty-palettes: wrote %d themes to %s\n' "$count" "$DEST"
