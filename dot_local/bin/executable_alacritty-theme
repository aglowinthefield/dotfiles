#!/bin/sh
# alacritty-theme — switch the terminal stack between the dark and light palette.
#
# Alacritty has no light/dark mode: it loads one palette and that is that. The
# switch is a *generated* ~/.config/alacritty/theme.toml which alacritty.toml
# imports at a fixed path; rewriting it makes live_config_reload repaint every
# open window. alacritty.toml itself is never touched, so the chezmoi-managed
# file stays clean and `chezmoi diff` stays quiet.
#
# tmux-dotbar rides along the same way — ~/.tmux/theme.conf, generated from
# ~/.tmux/dotbar-{dark,light}.conf — because the status bar is supposed to share
# the terminal's background, and a dark bar on a light terminal draws exactly
# the line the theme is built to avoid.
#
# herdr is *not* driven from here: its own [theme] auto_switch follows the host
# terminal's appearance, so repainting Alacritty is all it needs.
#
#   alacritty-theme dark | light   set a variant
#   alacritty-theme toggle         flip to the other one
#   alacritty-theme auto           follow the macOS system appearance
#   alacritty-theme status         print the current variant and its sources
#
# `dark` and `light` are exactly the words dark-notify passes as $1, so the
# com.tauty.alacritty-theme launchd agent runs this with no wrapper.

set -eu

# launchd hands the agent a bare PATH (/usr/bin:/bin:/usr/sbin:/sbin), so
# Homebrew's tmux is invisible when dark-notify triggers this — and it fails
# *silently*, because theme.conf on disk still updates and only the live
# re-source is skipped. Put the usual prefixes back.
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/alacritty"
THEME_FILE="$CONFIG_DIR/theme.toml"
TMUX_DIR="$HOME/.tmux"
TMUX_THEME_FILE="$TMUX_DIR/theme.conf"

# The two Alacritty variants live in different places on purpose. Dark is
# kanagawa_dragon from the vendored alacritty-theme checkout — #181616,
# deliberately the same as @tmux-dotbar-bg and herdr, so don't quietly swap it
# for paper-ink without changing those too. Light is kanagawa-paper-canvas from
# colors/, which is chezmoi-managed and so lands at the same path everywhere.
DARK_SOURCE="${ALACRITTY_THEME_DARK:-$CONFIG_DIR/themes/themes/kanagawa_dragon.toml}"
LIGHT_SOURCE="${ALACRITTY_THEME_LIGHT:-$CONFIG_DIR/colors/kanagawa-paper-canvas.toml}"

usage() {
	sed -n '18,21p' "$0" | sed 's/^# \{0,1\}//'
	exit "${1:-0}"
}

source_for() {
	case $1 in
	dark) printf '%s\n' "$DARK_SOURCE" ;;
	light) printf '%s\n' "$LIGHT_SOURCE" ;;
	esac
}

# Both generated files carry the variant on line 1; that marker is the only
# state this thing keeps.
variant_of() {
	sed -n '1s/^# variant: //p' "$1" 2>/dev/null | grep -E '^(dark|light)$' || echo unknown
}

current_variant() { variant_of "$THEME_FILE"; }

generate() {
	dest=$1 comment=$2 variant=$3 source=$4
	tmp=$(mktemp "$(dirname "$dest")/.theme.XXXXXX")
	{
		printf '%s variant: %s\n' "$comment" "$variant"
		printf '%s Generated by alacritty-theme from %s — edits are overwritten.\n\n' "$comment" "$source"
		cat "$source"
	} >"$tmp"
	# Truncate in place rather than rename into place: same inode, one plain
	# modify event, which is what Alacritty's config watcher wakes up on.
	cat "$tmp" >"$dest"
	rm -f "$tmp"
}

alacritty_apply() {
	variant=$1
	source=$(source_for "$variant")

	# A missing import fails *silently* in Alacritty — you get the default
	# #1a1a1a and no error — so refuse to generate a theme.toml built from a
	# file that isn't there.
	if [ ! -f "$source" ]; then
		printf 'alacritty-theme: no %s theme at %s\n' "$variant" "$source" >&2
		exit 1
	fi

	# Rewriting an unchanged theme would reload every window for nothing, and
	# dark-notify fires this once at login regardless of whether anything moved.
	[ "$(variant_of "$THEME_FILE")" = "$variant" ] && [ -s "$THEME_FILE" ] && return 0

	existed=false
	[ -f "$THEME_FILE" ] && existed=true
	generate "$THEME_FILE" "#" "$variant" "$source"

	# An Alacritty that started while theme.toml was absent never registered a
	# watch on it — you cannot watch a file that isn't there — so it ignores
	# every switch from then on and keeps whatever it loaded, silently. Poking
	# the top-level config, which *is* watched, makes it re-read the import list
	# and pick the file up. Only on creation: doing it every time would reload
	# each window twice.
	if [ "$existed" = false ]; then
		touch "$CONFIG_DIR/alacritty.toml" 2>/dev/null || true
	fi
}

tmux_apply() {
	variant=$1
	source="$TMUX_DIR/dotbar-$variant.conf"

	# Not every machine that runs this has the tmux config applied; that is a
	# reason to skip tmux, not to fail the terminal switch.
	[ -f "$source" ] || return 0

	if [ "$(variant_of "$TMUX_THEME_FILE")" != "$variant" ] || [ ! -s "$TMUX_THEME_FILE" ]; then
		generate "$TMUX_THEME_FILE" "#" "$variant" "$source"
	fi

	# A running server has already read the old palette and will not look again
	# on its own, so the bar would stay dark until the next server restart.
	if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
		tmux source-file "$TMUX_THEME_FILE" >/dev/null 2>&1 || true
		tmux refresh-client -S >/dev/null 2>&1 || true
	fi
}

set_variant() {
	alacritty_apply "$1"
	tmux_apply "$1"
}

system_variant() {
	case $(uname -s) in
	Darwin)
		# The key is absent entirely in light mode, hence the 2>/dev/null.
		if [ "$(defaults read -g AppleInterfaceStyle 2>/dev/null || true)" = "Dark" ]; then
			echo dark
		else
			echo light
		fi
		;;
	*)
		printf 'alacritty-theme: auto only knows how to read macOS appearance\n' >&2
		exit 1
		;;
	esac
}

case "${1:-}" in
dark | light) set_variant "$1" ;;
toggle)
	case $(current_variant) in
	dark) set_variant light ;;
	*) set_variant dark ;;
	esac
	;;
auto) set_variant "$(system_variant)" ;;
status)
	variant=$(current_variant)
	printf '%s\n' "$variant"
	[ "$variant" = unknown ] || printf 'alacritty: %s\n' "$(source_for "$variant")"
	if [ -f "$TMUX_THEME_FILE" ]; then
		printf 'tmux:      %s\n' "$TMUX_DIR/dotbar-$(variant_of "$TMUX_THEME_FILE").conf"
	fi
	printf 'herdr:     self-switching ([theme] auto_switch, follows the terminal)\n'
	;;
-h | --help) usage ;;
*) usage 1 ;;
esac
