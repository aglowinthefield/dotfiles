{{- if ne .chezmoi.os "windows" -}}
#!/bin/bash
# herdr plugins. reviewr is the code-review pane bound to prefix+d in
# ~/.config/herdr/config.toml; its own settings sit beside it under
# plugins/config/persiyanov.reviewr/. reviewr is macOS and Linux only.
#
# herdr installs itself rather than coming from a package manager, so on a
# machine that has not run its installer this exits quietly instead of failing
# the apply. Run on every apply so installing herdr later retries setup.

set -e

command -v herdr >/dev/null 2>&1 || exit 0

if herdr plugin list 2>/dev/null | grep -q 'persiyanov.reviewr'; then
  echo "herdr plugin persiyanov.reviewr already installed"
else
  echo "Installing herdr plugin persiyanov.reviewr..."
  herdr plugin install persiyanov/herdr-reviewr
fi
{{- end }}
