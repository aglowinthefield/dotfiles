{{- if ne .chezmoi.os "windows" -}}
#!/bin/sh
# Seed ~/.config/alacritty/theme.toml and font.toml.
#
# alacritty.toml imports both files unconditionally and a missing import is
# silent — a fresh machine would just get Alacritty's default black in its
# default font, with no error — so generate them here rather than waiting for
# the first manual switch.
# `auto` follows the system appearance on macOS; anywhere else it fails and we
# fall back to dark, which is what the config did before any of this existed.
# Hash: {{ include "dot_local/bin/executable_alacritty-theme" | sha256sum }}
# Hash: {{ include "dot_local/bin/executable_alacritty-font" | sha256sum }}

set -e

theme="$HOME/.local/bin/alacritty-theme"
"$theme" auto 2>/dev/null || "$theme" dark
echo "Alacritty theme: $("$theme" status | head -1)"

# font.toml is imported unconditionally too, and carries this machine's font now
# that alacritty.toml no longer does — so it has to exist before Alacritty next
# starts, or the font silently falls back to Alacritty's own default.
font="$HOME/.local/bin/alacritty-font"
"$font" apply
echo "Alacritty font:  $("$font" status | head -1)"
{{- end }}
