{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
# Enable the git maintenance timers.
# gm: {{ include "dot_config/systemd/user/git-maintenance@.service" | sha256sum }}
# gm-hourly: {{ include "dot_config/systemd/user/git-maintenance@hourly.timer" | sha256sum }}
if systemctl --user show-environment >/dev/null 2>&1; then
  systemctl --user daemon-reload
  systemctl --user enable --now git-maintenance@hourly.timer git-maintenance@daily.timer git-maintenance@weekly.timer
fi
{{- end }}
