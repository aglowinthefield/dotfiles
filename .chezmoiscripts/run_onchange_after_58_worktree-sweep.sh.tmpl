{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
# Schedule worktree-sweep every 2 hours. macOS uses `worktree-sweep --install-agent`.
# timer: {{ include "dot_config/systemd/user/worktree-sweep.timer" | sha256sum }}
# service: {{ include "dot_config/systemd/user/worktree-sweep.service" | sha256sum }}
if systemctl --user show-environment >/dev/null 2>&1; then
  systemctl --user daemon-reload
  systemctl --user enable --now worktree-sweep.timer
fi
{{- end }}
