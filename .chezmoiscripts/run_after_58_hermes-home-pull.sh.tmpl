{{- if ne .chezmoi.os "windows" -}}
#!/bin/sh
# Keep ~/.hermes current with hermes-home on every apply. 57 only re-runs when its
# own text changes, so without this each host drifts behind until someone pulls
# by hand. Runs every apply, so it always shows as `R` in `chezmoi status`.
#
# Fast-forward only, and never fails the apply: a diverged or dirty checkout is
# someone's work in progress, so say so and leave it.

home="$HOME/.hermes"
[ -d "$home/.git" ] || exit 0

# .gitattributes routes the config.yaml files through hermes-local-keys so each
# host keeps its own pet and dashboard theme. Filter drivers live in per-clone
# config, not in the repo, so register it here on every host. The driver comes
# from chezmoi rather than the repo so it is on disk before the first pull that
# needs it.
filter="$HOME/.local/bin/hermes-local-keys"
git -C "$home" config filter.hermes-local-keys.clean "'$filter' clean %f"
git -C "$home" config filter.hermes-local-keys.smudge "'$filter' smudge %f"
git -C "$home" config --unset filter.hermes-cron-state.clean 2>/dev/null

# Seed the host's values before pulling: git skips the clean filter on files
# whose stat matches the index, and smudge can only restore what clean stashed.
(cd "$home" && for f in config.yaml profiles/*/config.yaml; do
	[ -f "$f" ] && "$filter" clean "$f" <"$f" >/dev/null
done) || echo "hermes-home: could not stash per-host config keys" >&2

git -C "$home" pull --ff-only --quiet ||
	echo "hermes-home: could not fast-forward, leaving the checkout as-is" >&2

# Charm tracks main rather than a pack pin (see hermes-home's README). Hermes'
# updater fast-forwards it and reapplies any local edits.
if [ -d "$home/plugins/charm" ] && command -v hermes >/dev/null 2>&1; then
	hermes plugins update charm >/dev/null 2>&1 ||
		echo "hermes-home: could not update Charm; a pinned install needs reinstalling from main" >&2
fi
exit 0
{{- end }}
