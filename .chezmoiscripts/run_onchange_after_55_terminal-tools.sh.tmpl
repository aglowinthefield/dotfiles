{{- if ne .chezmoi.os "windows" -}}
#!/bin/sh
{{ template "homebrew-path.sh" . }}
# Install alacritty-theme and alacritty-font from their own repo.
#
# They used to live in this repo, but they are tools rather than dotfiles and
# are wanted on machines that do not run chezmoi. This repo is public and that
# one is private, so a clone needs the SSH key already working — on a brand new
# machine that means 1Password unlocked. Fail if cloning fails so chezmoi
# retries on the next `chezmoi apply` once the key is available.
#
# install.sh does the rest: symlinks into ~/.local/bin, links the palettes where
# alacritty.toml and .tmux.conf expect them, seeds the generated theme.toml and
# font.toml, and loads the dark-notify agent on macOS.
#
# This only re-runs when the script below changes, so `git -C ~/code/terminal-tools
# pull` is the way to take updates in between.
# Hash: {{ include ".chezmoiscripts/run_onchange_after_55_terminal-tools.sh.tmpl" | sha256sum }}

set -e

repo="$HOME/code/terminal-tools"
url="git@github.com:aglowinthefield/terminal-tools.git"

# The repo was called alacritty-tools until it grew kitty and ghostty support.
# Renaming it changes this script, so run_onchange re-runs everywhere; move an
# existing checkout across rather than cloning a second one and orphaning the
# first. install.sh below repoints the ~/.local/bin and palette symlinks.
old="$HOME/code/alacritty-tools"
if [ -d "$old/.git" ] && [ ! -d "$repo/.git" ]; then
	echo "terminal-tools: moving $old to $repo"
	mv "$old" "$repo"
	git -C "$repo" remote set-url origin "$url"
fi

if [ -d "$repo/.git" ]; then
	git -C "$repo" pull --ff-only --quiet 2>/dev/null ||
		echo "terminal-tools: could not pull, using the checkout as-is"
else
	mkdir -p "$(dirname "$repo")"
	if ! git clone --quiet "$url" "$repo"; then
		echo "terminal-tools: clone failed; unlock SSH access and retry chezmoi apply" >&2
		exit 1
	fi
fi

"$repo/install.sh"

# kitty reads a flat .conf where alacritty reads TOML, so the vendored palettes
# have to be converted before `kitten themes` can list them. kitty's own theme
# repository has gruvbox, nord, kanagawa and the rest, but not token — that one
# exists only here. Seeded from the same checkout install.sh just refreshed, so
# it runs after it and is a skip rather than a failure when kitty is absent.
if command -v kitty >/dev/null 2>&1; then
	"$HOME/.local/bin/kitty-palettes" ||
		echo "kitty-palettes: could not convert palettes, kitty keeps its downloaded themes"
fi

# Same conversion again for ghostty, which reads its own flat format out of
# ~/.config/ghostty/themes and resolves a theme by file name. It ships 463
# themes and token is not among them either.
if command -v ghostty >/dev/null 2>&1; then
	"$HOME/.local/bin/ghostty-palettes" ||
		echo "ghostty-palettes: could not convert palettes, ghostty keeps its built-in themes"

	# Converting the palettes only makes them selectable; ghostty still has to be
	# pointed at the pair. Seeded only when absent, the same bargain as
	# create_ files elsewhere here: auto/theme.ghostty is where `ghostty-theme`
	# records a local pick, and this script re-runs on every edit to it, so
	# writing unconditionally would throw that pick away. An absent file is
	# meaningful to ghostty-theme — it means the machine default — so the test
	# is on the file, not on its contents.
	#
	# Called by absolute path, like kitty-palettes above: install.sh has just
	# symlinked it into ~/.local/bin, but chezmoi runs this under sh and only
	# fish puts that directory on PATH, so a bare name would silently skip on a
	# new machine.
	if [ ! -e "$HOME/.config/ghostty/auto/theme.ghostty" ]; then
		"$HOME/.local/bin/ghostty-theme" auto "Token Light" "Token Dark" ||
			echo "ghostty-theme: could not set the token pair, ghostty keeps its default"
	fi
fi
{{- end }}
