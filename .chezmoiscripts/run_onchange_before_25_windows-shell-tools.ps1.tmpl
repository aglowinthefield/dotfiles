{{- if eq .chezmoi.os "windows" -}}
# Runs after package installation and before the PowerShell profile is applied.
$ErrorActionPreference = 'Stop'
{{ template "scoop-path.ps1" . }}

foreach ($module in @('PSReadLine', 'PSFzf', 'CompletionPredictor')) {
    if (-not (Get-Module -ListAvailable -Name $module)) {
        Install-Module -Name $module -Repository PSGallery -Scope CurrentUser -Force -AllowClobber -ErrorAction Stop
    }
}

# An earlier install may have updated user PATH without updating this process.
$env:PATH = [Environment]::GetEnvironmentVariable('Path', 'User') + ';' + $env:PATH
if (-not (Get-Command herdr -ErrorAction SilentlyContinue)) {
    # Official stable installer preserves the app-local ConPTY runtime.
    $installer = Join-Path ([IO.Path]::GetTempPath()) ('herdr-install-' + [guid]::NewGuid() + '.ps1')
    try {
        Invoke-WebRequest -Uri 'https://herdr.dev/install.ps1' -OutFile $installer
        & (Join-Path $env:ProgramFiles 'PowerShell\7\pwsh.exe') -NoLogo -NoProfile -ExecutionPolicy Bypass -File $installer -Channel stable
        if ($LASTEXITCODE -ne 0) { throw "Herdr installation failed (exit code $LASTEXITCODE)" }
    } finally {
        Remove-Item -LiteralPath $installer -Force -ErrorAction SilentlyContinue
    }
    $env:PATH = [Environment]::GetEnvironmentVariable('Path', 'User') + ';' + $env:PATH
}
if (-not (Get-Command herdr -ErrorAction SilentlyContinue)) {
    throw 'Herdr is not available after installation; check the installer output and PATH.'
}
{{- end -}}
