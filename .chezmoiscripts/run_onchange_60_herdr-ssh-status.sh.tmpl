{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# launchd agent for the herdr ssh-status daemon (~/bin/herdr-ssh-status.py)
# Hash: {{ include ".chezmoiscripts/run_onchange_60_herdr-ssh-status.sh.tmpl" | sha256sum }}
#
# Installed by script rather than as a managed file so that chezmoi never
# takes ownership of ~/Library/LaunchAgents and rewrites its permissions.

set -e

label="com.tauty.herdr-ssh-status"
plist="{{ .chezmoi.homeDir }}/Library/LaunchAgents/${label}.plist"

echo "Installing ${label}..."

tmp="$(mktemp)"
cat >"$tmp" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.tauty.herdr-ssh-status</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>{{ .chezmoi.homeDir }}/bin/herdr-ssh-status.py</string>
	</array>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<true/>

	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/herdr-ssh-status.log</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/herdr-ssh-status.log</string>
</dict>
</plist>
PLIST

# install(1) writes the file without touching the parent directory's mode.
install -m 644 "$tmp" "$plist"
rm -f "$tmp"

launchctl bootout "gui/$(id -u)/${label}" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$plist"
{{- end }}
